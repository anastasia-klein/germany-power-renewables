table fact_market_hour
	lineageTag: 272dcc84-6639-4c97-a2a0-a9351a797e83
	sourceLineageTag: [gold].[fact_market_hour]

	measure 'Average Price EUR per MWh' =
			
			AVERAGE('fact_market_hour'[day_ahead_price_eur_mwh])
		formatString: 0.00
		lineageTag: d803aa14-7d0a-4642-91e2-0838ca1f71c5

		changedProperty = Name

		changedProperty = FormatString

	measure 'Grid Load TWh' =
			
			DIVIDE(
			    SUM('fact_market_hour'[grid_load_mwh]),
			    1000000
			)
		formatString: 0.00
		lineageTag: 070586ca-e2d1-4172-a843-617ac4e7da2c

		changedProperty = Name

		changedProperty = FormatString

	measure 'Load Profile Price Gap EUR per MWh' =
			
			[Load Weighted Price EUR per MWh]
			    - [Average Price EUR per MWh]
		formatString: 0.0
		lineageTag: af32bac9-f57a-45f1-909a-f5a553513279

		changedProperty = Name

		changedProperty = FormatString

	measure 'Load Weighted Price EUR per MWh' =
			
			DIVIDE(
			    SUM('fact_market_hour'[price_weighted_load_eur]),
			    SUM('fact_market_hour'[matched_grid_load_mwh])
			)
		formatString: 0.00
		lineageTag: 264fddb6-2473-41aa-8dc7-2135f9013360

		changedProperty = Name

		changedProperty = FormatString

	measure 'Market Hours' =
			
			COUNTROWS('fact_market_hour')
		formatString: 0
		lineageTag: 0ec5f97a-127a-4363-a13f-6ff19bee0740

		changedProperty = Name

	measure 'Wind Solar Load Ratio' =
			
			DIVIDE(
			    SUM('fact_market_hour'[wind_solar_mwh]),
			    SUM('fact_market_hour'[grid_load_mwh])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0327c92c-55f4-477d-8fee-4aed862f515f

		changedProperty = Name

		changedProperty = FormatString

	measure 'Valid Price Hours' =
			CALCULATE(
			    COUNTROWS('fact_market_hour'),
			    'fact_market_hour'[is_valid_price] = TRUE()
			)
		formatString: 0
		lineageTag: 13c8cb91-0090-4464-aac1-094c195587f1

	measure 'Negative Price Hours' =
			COALESCE(
			    CALCULATE(
			        COUNTROWS('fact_market_hour'),
			        'fact_market_hour'[is_negative_price] = TRUE()
			    ),
			    0
			)
		formatString: 0
		lineageTag: 42abcb8f-cc91-4b87-a61d-ce7d34164926

	measure 'Negative Price Hour Share' =
			DIVIDE([Negative Price Hours], [Valid Price Hours])
		formatString: 0.00%
		lineageTag: dd579e52-85f0-4248-8d9f-8bd862523297

	measure 'Residual Load TWh' =
			DIVIDE(SUM('fact_market_hour'[residual_load_mwh]), 1000000)
		formatString: 0.00
		lineageTag: 14826d16-5e8a-451f-8f71-35d8e02bcfe1

	measure 'Timeline Average Price' =
			VAR SingleMonth = HASONEVALUE('report_month'[month_number])
			VAR Grain = SELECTEDVALUE('report_axis'[grain])
			VAR AxisMonth = SELECTEDVALUE('report_axis'[month_number])
			VAR AxisDay = SELECTEDVALUE('report_axis'[day_number])
			RETURN
			    SWITCH(
			        TRUE(),
			        SingleMonth && Grain = "Day" && AxisMonth = SELECTEDVALUE('report_month'[month_number]),
			            CALCULATE([Average Price EUR per MWh], TREATAS({DATE(2025, AxisMonth, AxisDay)}, 'dim_time_hour'[local_date])),
			        NOT SingleMonth && Grain = "Month" && AxisMonth IN VALUES('report_month'[month_number]),
			            CALCULATE([Average Price EUR per MWh], TREATAS({AxisMonth}, 'dim_time_hour'[month])),
			        BLANK()
			    )
		lineageTag: e379f051-77e6-5e7e-a97b-fa8473038d70
		displayFolder: Report presentation
		formatString: 0.00

	measure 'Timeline Load Weighted Price' =
			VAR SingleMonth = HASONEVALUE('report_month'[month_number])
			VAR Grain = SELECTEDVALUE('report_axis'[grain])
			VAR AxisMonth = SELECTEDVALUE('report_axis'[month_number])
			VAR AxisDay = SELECTEDVALUE('report_axis'[day_number])
			RETURN
			    SWITCH(
			        TRUE(),
			        SingleMonth && Grain = "Day" && AxisMonth = SELECTEDVALUE('report_month'[month_number]),
			            CALCULATE([Load Weighted Price EUR per MWh], TREATAS({DATE(2025, AxisMonth, AxisDay)}, 'dim_time_hour'[local_date])),
			        NOT SingleMonth && Grain = "Month" && AxisMonth IN VALUES('report_month'[month_number]),
			            CALCULATE([Load Weighted Price EUR per MWh], TREATAS({AxisMonth}, 'dim_time_hour'[month])),
			        BLANK()
			    )
		lineageTag: c730579f-9c49-53b9-a514-0fd85f5d504d
		displayFolder: Report presentation
		formatString: 0.00

	measure 'Timeline Wind Solar Load Ratio' =
			VAR SingleMonth = HASONEVALUE('report_month'[month_number])
			VAR Grain = SELECTEDVALUE('report_axis'[grain])
			VAR AxisMonth = SELECTEDVALUE('report_axis'[month_number])
			VAR AxisDay = SELECTEDVALUE('report_axis'[day_number])
			RETURN
			    SWITCH(
			        TRUE(),
			        SingleMonth && Grain = "Day" && AxisMonth = SELECTEDVALUE('report_month'[month_number]),
			            CALCULATE([Wind Solar Load Ratio], TREATAS({DATE(2025, AxisMonth, AxisDay)}, 'dim_time_hour'[local_date])),
			        NOT SingleMonth && Grain = "Month" && AxisMonth IN VALUES('report_month'[month_number]),
